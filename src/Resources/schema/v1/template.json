{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:metadata-driven:schema:v1:template",
    "title": "The spec of a Template document: the manifest of a package",
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "label", "license", "requires", "resources"],
    "properties": {
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "license": { "type": "string", "minLength": 1, "maxLength": 100, "description": "An SPDX license identifier, e.g. MIT, or proprietary" },
        "requires": {
            "type": "object",
            "required": ["format"],
            "properties": { "format": { "const": "metadata-driven/v1" } },
            "propertyNames": { "pattern": "^(format|[a-z][a-z0-9-]*/[a-z][a-z0-9-]*)$" },
            "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "resources": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9_-]+/[a-z0-9_*.-]+\\.yaml$" }
        },
        "migrations": { "type": "object", "additionalProperties": { "type": "array" } }
    }
}
