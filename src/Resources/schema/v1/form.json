{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:metadata-driven:schema:v1:form",
    "title": "The spec of a Form document: a composite form, its object and via as ids",
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "definition"],
    "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "maxLength": 50 },
        "definition": {
            "type": "object",
            "required": ["label", "object"],
            "description": "The composite form definition the app accepts, with every object and via given as an id"
        }
    }
}
