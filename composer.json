{
    "name": "fedale/template-format",
    "type": "library",
    "description": "The metadata-driven template format: schemas, package reader, structural checks, archives, signed indexes",
    "keywords": ["metadata-driven", "templates", "json-schema", "ed25519"],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-sodium": "*",
        "ext-zlib": "*",
        "opis/json-schema": "^2.6",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Fedale\\TemplateFormat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fedale\\TemplateFormat\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --no-progress",
        "test": "phpunit",
        "qa": ["@cs", "@phpstan", "@test"]
    }
}
