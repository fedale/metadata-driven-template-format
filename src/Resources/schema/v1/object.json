{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:metadata-driven:schema:v1:object",
    "title": "The spec of an Object document: an object and its fields",
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "label", "plural", "fields"],
    "properties": {
        "name": { "$ref": "#/$defs/machineName" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "plural": { "type": "string", "minLength": 1, "maxLength": 100 },
        "icon": { "type": ["string", "null"], "maxLength": 50 },
        "label_field": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "search": {
            "oneOf": [
                { "type": "null" },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Left out or null: the app's default (its default handler, its text fields)",
                    "properties": {
                        "handler": { "type": ["string", "null"], "minLength": 1 },
                        "fields": { "oneOf": [{ "type": "null" }, { "type": "array", "items": { "$ref": "#/$defs/id" } }] }
                    }
                }
            ]
        },
        "unique_together": {
            "type": "array",
            "items": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/id" } }
        },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
    },
    "$defs": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
        "machineName": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "maxLength": 50 },
        "field": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "type", "label"],
            "properties": {
                "id": { "$ref": "#/$defs/id" },
                "name": { "$ref": "#/$defs/machineName" },
                "type": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1, "maxLength": 100 },
                "required": { "type": "boolean" },
                "unique": { "type": "boolean" },
                "settings": { "type": ["object", "array"], "maxItems": 0, "description": "Checked per type by the field type catalog; an empty map may be written as []" },
                "condition": {
                    "oneOf": [
                        { "type": "null" },
                        {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["field", "values"],
                            "properties": {
                                "field": { "$ref": "#/$defs/id" },
                                "values": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                            }
                        }
                    ]
                }
            }
        }
    }
}
