{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:metadata-driven:schema:v1:translations",
    "title": "The spec of a Translations document: the texts of one language",
    "type": "object",
    "additionalProperties": false,
    "required": ["locale", "entries"],
    "properties": {
        "locale": { "type": "string", "pattern": "^[a-z]{2}(_[A-Z]{2})?$" },
        "entries": {
            "type": ["object", "array"],
            "maxItems": 0,
            "propertyNames": { "pattern": "^[a-z]+\\..+$" },
            "additionalProperties": { "type": "string" }
        }
    }
}
